// ---------------------------------------------------------------- modes
enum Mode : uint8_t { MODE_BOARD, MODE_VIDEO, MODE_TEXT, MODE_WEATHER, MODE_DATETIME,
                      MODE_TIMER, MODE_EVENT, MODE_MARQUEE, MODE_IMAGE, MODE_INFO, MODE_COUNT };
static const char* const MODE_KEYS[]   = { "board", "video", "text", "weather", "datetime",
                                           "timer", "event", "marquee", "image", "info" };
static const char* const MODE_TITLES[] = { "Writing Board", "Video Player", "Text Display", "Weather", "Date & Time",
                                           "Timer", "Event Countdown", "Scrolling Text", "Image", "Device Info" };

// ---------------------------------------------------------------- saved settings (EEPROM)
struct Settings {
  uint16_t magic;
  uint8_t  version;
  uint8_t  contrast;     // 0..255
  uint8_t  flip;         // 0/1  rotate 180 degrees
  uint8_t  invert;       // 0/1  hardware invert
  uint8_t  dimMinutes;   // 0 = never; dims the IP screen after N idle minutes
  uint8_t  clockStyle;   // 0 classic, 1 big, 2 analog
  uint8_t  h12;          // 0 = 24 h, 1 = 12 h
  uint8_t  reserved;
  uint32_t eventTs;      // epoch seconds (IST midnight of the event day); 0 = none
  char     eventTitle[21];
  uint8_t  checksum;
};
Settings cfg;
static const uint16_t CFG_MAGIC = 0xB10D;

uint8_t cfgChecksum(const Settings& s) {
  const uint8_t* p = (const uint8_t*)&s;
  uint8_t sum = 0x5A;
  for (size_t i = 0; i < offsetof(Settings, checksum); i++) sum = (uint8_t)(sum * 31 + p[i]);   // everything before the checksum byte
  return sum;
}
void cfgDefaults() {
  memset(&cfg, 0, sizeof(cfg));
  cfg.magic = CFG_MAGIC; cfg.version = 1; cfg.contrast = 255;
}
void cfgSave() {
  cfg.checksum = cfgChecksum(cfg);
  EEPROM.put(0, cfg);
  EEPROM.commit();
}
void cfgLoad() {
  EEPROM.begin(sizeof(Settings) + 4);
  EEPROM.get(0, cfg);
  bool ok = cfg.magic == CFG_MAGIC && cfg.version == 1 && cfg.checksum == cfgChecksum(cfg) &&
            cfg.flip <= 1 && cfg.invert <= 1 && cfg.clockStyle <= 2 && cfg.h12 <= 1;
  if (!ok) cfgDefaults();
  cfg.eventTitle[sizeof(cfg.eventTitle) - 1] = 0;
}

