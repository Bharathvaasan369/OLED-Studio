static const int      DST_OFFSET_SECONDS = 0;
static const uint32_t LEASE_MS           = 30000UL;      // browser heartbeats every 5 s (1 s in Timer)
static const uint32_t ANNOUNCE_MS        = 3000UL;
static const uint32_t I2C_CLOCK_HZ       = 400000UL;     // try 100000 if the picture is corrupted
static const uint8_t  MAX_BAD_CODES      = 5;
static const uint32_t LOCKOUT_MS         = 60000UL;
static const size_t   FRAME_BYTES        = 1024;
static const uint16_t MQ_MAX_W           = 640;          // scrolling-text strip: 4 pages (32 px) x up to 640 px
